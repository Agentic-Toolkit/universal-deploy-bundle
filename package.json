{
  "name": "universal-deploy-bundle",
  "version": "5.6.0",
  "description": "V5.6.0 - Complete Deployment Platform: Cryptographic integrity (V5.3), distributed state (V5.4), service mesh (V5.5), and air-gap support (V5.6)",
  "main": "intelligent-deployer-universal-v5.1.js",
  "bin": {
    "universal-deploy-v5": "./intelligent-deployer-universal-v5.1.js"
  },
  "scripts": {
    "setup": "node scripts/interactive-setup.js",
    "deploy": "node intelligent-deployer-universal-v5.1.js",
    "deploy:production": "node intelligent-deployer-universal-v5.1.js production",
    "deploy:staging": "node intelligent-deployer-universal-v5.1.js staging",
    "deploy:local": "node intelligent-deployer-universal-v5.1.js development --local",
    "deploy:verify": "node intelligent-deployer-universal-v5.1.js production --verify",
    "deploy:full": "node intelligent-deployer-universal-v5.1.js production --verify-layer full",
    "deploy:basic": "node intelligent-deployer-universal-v5.1.js production --verify-layer basic",
    "verify-zero-errors": "node scripts/verify-zero-errors.js",
    "verify-runtime": "node scripts/verify-runtime-errors.js",
    "verify-all": "node scripts/verify-all.js",
    "verify-all:full": "node scripts/verify-all.js --layer full",
    "verify-all:basic": "node scripts/verify-all.js --layer basic",
    "security": "node core/security-scanner.js",
    "security:scan": "node core/security-scanner.js",
    "security:fix": "node core/security-scanner.js --fix",
    "security:enterprise": "node core/security-scanner.js --enterprise --fix",
    "security:compliance": "node core/security-scanner.js --enterprise --compliance",
    "ai:status": "node core/ai-automation-interface.js --status",
    "ai:self-heal": "node core/ai-automation-interface.js --enterprise --enable-self-healing",
    "ai:anomaly": "node core/ai-automation-interface.js --enterprise --enable-anomaly",
    "ai:predict": "node core/ai-automation-interface.js --enterprise --predict",
    "license:validate": "node core/enterprise-license-manager.js --validate",
    "license:status": "node core/enterprise-license-manager.js --status",
    "license:activate": "node core/enterprise-license-manager.js --activate",
    "integrity:generate": "node scripts/integrity/integrity-generate.js",
    "integrity:verify": "node scripts/integrity/integrity-verify.js",
    "integrity:report": "node scripts/integrity/integrity-report.js",
    "integrity:history": "node core/integrity/CryptographicIntegrityManager.js history",
    "integrity:clean": "node core/integrity/CryptographicIntegrityManager.js clean",
    "security:integrity": "npm run integrity:verify",
    "deploy:gate": "node scripts/verify-deployment-integrity.js",
    "deploy:v5.3": "npm run deploy:gate && npm run deploy:full",
    "cni:verify": "node core/cni/CNIComplianceChecker.js",
    "security:cni": "npm run integrity:verify && npm run cni:verify",
    "distributed:init": "node core/distributed/EtcdStateManager.js init",
    "distributed:status": "node core/distributed/EtcdStateManager.js status",
    "distributed:elect": "node core/distributed/EtcdStateManager.js elect --enterprise",
    "integrity:generate-keys": "node core/distributed/SignatureManager.js generate",
    "integrity:verify-sig": "node core/distributed/SignatureManager.js verify",
    "integrity:key-info": "node core/distributed/SignatureManager.js info",
    "deploy:v5.4": "npm run distributed:init && npm run deploy:v5.3",
    "smi:verify": "node core/servicemesh/SMIVerifier.js",
    "security:smi": "npm run smi:verify",
    "airgap:create": "node core/airgap/AirGapManager.js create",
    "airgap:verify": "node core/airgap/AirGapManager.js verify",
    "airgap:deploy": "node core/airgap/AirGapManager.js deploy",
    "deploy:v5.6": "npm run airgap:create && npm run deploy:full",
    "test:all": "node scripts/test-all.js",
    "test:integrity": "node scripts/test-all.js",
    "test:unit": "node scripts/test-all.js"
  },
  "keywords": [
    "deployment",
    "automation",
    "universal",
    "ssh",
    "next.js",
    "verification",
    "zero-error",
    "runtime-verification",
    "browser-testing",
    "http-verification",
    "e2e-testing",
    "multi-layer-verification",
    "playwright",
    "deployment-verifier",
    "complete-integration",
    "v5.1",
    "v5.2",
    "v5.3",
    "v5.4",
    "v5.5",
    "v5.6",
    "security",
    "vulnerability-scanner",
    "owasp",
    "ci-cd",
    "ai-automation",
    "self-healing",
    "anomaly-detection",
    "predictive-scaling",
    "enterprise-license",
    "professional-services",
    "cryptographic-integrity",
    "sha-256",
    "sha-512",
    "code-corruption-detection",
    "manifest-verification",
    "cni-compliance",
    "container-security",
    "distributed-state",
    "etcd",
    "raft-consensus",
    "service-mesh",
    "smi-spec",
    "mTLS",
    "air-gap",
    "immutable-deployment"
  ],
  "author": "",
  "license": "MIT WITH RESTRICTIONS - See LICENSE file",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agentic-Toolkit/universal-deploy-bundle"
  },
  "homepage": "https://github.com/Agentic-Toolkit/universal-deploy-bundle#readme",
  "bugs": {
    "url": "https://github.com/Agentic-Toolkit/universal-deploy-bundle/issues"
  },
  "files": [
    "intelligent-deployer-universal-v5.1.js",
    "scripts",
    "core",
    "hooks",
    "examples",
    "templates",
    "tests",
    "docs",
    ".github/workflows",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".gitignore"
  ],
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "glob": "^10.3.10",
    "inquirer": "^8.2.5",
    "node-ssh": "^13.2.0",
    "tar": "^7.5.19"
  },
  "devDependencies": {
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
